[Unit]
Description=Check ghcr.io/gemini-rtsw/rpm-repo:latest for a new image every minute

# Polling, because GitHub cannot reach the internal mirror hosts to signal a
# publish. An unchanged check is one manifest request, so a 1-minute interval
# costs almost nothing and a new build is served within about a minute. No
# RandomizedDelaySec: there are only one or two mirrors (GN, GS), so there is
# no fleet to spread out. Refresh now: sudo systemctl start rpm-repo-mirror-update
[Timer]
OnBootSec=1min
OnUnitActiveSec=1min

[Install]
WantedBy=timers.target
